<!--
  Stable lane-following tree for Scout Mini.

  Replan at a low, stable rate so every controller retry receives a newly
  computed non-empty path. The previous cached-path fallback could accept an
  empty path after MPPI aborted and repeatedly resend it to FollowPath.
  Recovery deliberately excludes Spin and BackUp: an unexpected in-place
  rotation or blind reverse is unsafe near lane boundaries and on bridges.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="4" name="NavigateLaneSafe">
      <PipelineSequence name="NavigateWithStablePath">
        <RateController hz="0.5" name="ReplanAtHalfHz">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose
              goal="{goal}"
              path="{path}"
              planner_id="GridBased"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmapAfterPlanningFailure"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <!--
          Do not immediately retry FollowPath after clearing the costmap:
          MPPI clears its failed input path while aborting, so that retry used
          to receive zero poses. Let the outer recovery wait/clear, then return
          through ComputePathToPose before FollowPath can run again.
        -->
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>
      <ReactiveFallback name="SafeRecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="SafeRecoveryActions">
          <Wait name="WaitForTemporaryObstacle" wait_duration="3"/>
          <Sequence name="RefreshCostmaps">
            <ClearEntireCostmap
              name="ClearLocalCostmap"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmap"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
